{
  "name": "Mino",
  "version": "1.0.0",
  "type": "module",
  "description": "一个简洁的Agent工具",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/agent.ts",
    "build": "esbuild src/agent.ts --bundle --platform=node --format=esm --target=node20 --packages=bundle --external:better-sqlite3 --external:@webviewjs/webview --external:@webviewjs/webview-* --banner:js=\"import { createRequire as __createRequire } from 'node:module'; const require = __createRequire(import.meta.url);\" --outfile=build/app.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.6.1",
    "@langchain/core": "^1.3.5",
    "@langchain/deepseek": "^1.1.23",
    "@langchain/langgraph": "^1.7.2",
    "@langchain/langgraph-checkpoint-sqlite": "^1.1.0",
    "@langchain/openai": "^1.8.2",
    "@webviewjs/webview": "^0.6.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "katex": "^0.18.11",
    "langchain": "^1.6.3",
    "marked": "^18.1.3",
    "marked-katex-extension": "^5.1.13",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.25.12",
    "typescript": "^7.0.2"
  }
}
